# ── Mercado Libre OAuth ──────────────────────────────────────────
CLIENT_ID=your_meli_client_id
CLIENT_SECRET=your_meli_client_secret

# Update this AFTER you create the Cloudflare Tunnel and get your public URL
# Example: https://meliprecios.yourdomain.com/callback
REDIRECT_URI=https://YOUR_TUNNEL_URL/callback

# ── Turso Database ───────────────────────────────────────────────
TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your_turso_auth_token

# ── Server ───────────────────────────────────────────────────────
PORT=3000

# ── Cloudflare Tunnel ────────────────────────────────────────────
# Create a tunnel at: https://one.dash.cloudflare.com → Networks → Tunnels
# Point it to: http://meliprecios:3000
# Copy the tunnel token here:
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ── Local Development Tunnel (localtunnel) ───────────────────────
# When running locally using "npm run local", request a custom subdomain.
# This keeps your redirect URI constant in Mercado Libre app settings.
# Example: if you set this to tatan-meli, the tunnel URL will be https://tatan-meli.localtunnel.me
LOCALTUNNEL_SUBDOMAIN=your_custom_subdomain
